{
  "backtest": {
    "inputSchema": {
      "properties": {
        "balance": {
          "default": 10000.0,
          "description": "Starting USD balance. Default 10000.",
          "title": "Balance",
          "type": "number"
        },
        "data_path": {
          "description": "Path to a CSV or JSON file of price snapshots (timestamp, market_slug, outcome, midpoint); must be under the home directory or /tmp.",
          "title": "Data Path",
          "type": "string"
        },
        "depth": {
          "default": 500.0,
          "description": "Synthetic order-book size in shares at each price level. Default 500.",
          "title": "Depth",
          "type": "number"
        },
        "spread": {
          "default": 0.02,
          "description": "Synthetic order-book spread as a price fraction (0.02 = 2 cents). Default 0.02.",
          "title": "Spread",
          "type": "number"
        },
        "strategy_path": {
          "description": "Dotted Python path of the strategy function, e.g. 'examples.momentum.run'; only 'examples.' modules are allowed.",
          "title": "Strategy Path",
          "type": "string"
        }
      },
      "required": [
        "data_path",
        "strategy_path"
      ],
      "title": "backtestArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "backtestOutput",
      "type": "object"
    }
  },
  "buy": {
    "inputSchema": {
      "properties": {
        "account": {
          "default": "default",
          "description": "Paper account name; any name without '/', '\\', '..' or surrounding spaces. Each name is a separate local account. Default 'default'.",
          "title": "Account",
          "type": "string"
        },
        "amount_usd": {
          "description": "USD to spend, e.g. 100. Minimum 1.0 on Polymarket; no minimum on Kalshi.",
          "title": "Amount Usd",
          "type": "number"
        },
        "order_type": {
          "default": "fok",
          "description": "'fok' (fill-or-kill: all or nothing) or 'fak' (fill-and-kill: partial fills allowed). Default 'fok'.",
          "title": "Order Type",
          "type": "string"
        },
        "outcome": {
          "description": "Outcome to trade, e.g. 'yes' or 'no' (case-insensitive); must match one of the market's outcomes.",
          "title": "Outcome",
          "type": "string"
        },
        "slug_or_id": {
          "description": "Market slug or condition ID. For a Kalshi market use the slug 'kalshi:<TICKER>', e.g. 'kalshi:KXNBAGAME-26OCT16DENLAL-LAL'.",
          "title": "Slug Or Id",
          "type": "string"
        }
      },
      "required": [
        "slug_or_id",
        "outcome",
        "amount_usd"
      ],
      "title": "buyArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "buyOutput",
      "type": "object"
    }
  },
