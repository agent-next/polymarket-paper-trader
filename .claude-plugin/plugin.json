{
  "$schema": "https://json.schemastore.org/claude-code-plugin.json",
  "name": "polymarket-paper-trader",
  "displayName": "Polymarket Paper Trader",
  "version": "0.4.0",
  "description": "Paper trading simulator for Polymarket prediction markets: $10k paper money, real order books, zero risk. Bundles the trading skill and the pm-trader-mcp server.",
  "author": {
    "name": "agent-next"
  },
  "homepage": "https://github.com/agent-next/polymarket-paper-trader",
  "repository": "https://github.com/agent-next/polymarket-paper-trader",
  "license": "MIT",
  "keywords": ["polymarket", "trading", "prediction-markets", "mcp", "paper-trading"],
  "skills": ["./skill/polymarket-paper-trader"],
  "mcpServers": {
    "polymarket-paper-trader": {
      "command": "uvx",
      "args": ["--from", "polymarket-paper-trader", "pm-trader-mcp"]
    }
  }
}
