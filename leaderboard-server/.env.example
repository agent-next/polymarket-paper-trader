# SQLite database path (use :memory: for ephemeral dev)
DATABASE_URL=/data/leaderboard.db

# Backup configuration
BACKUP_DIR=/data/backups
BACKUP_INTERVAL=3600

# Public URL
LEADERBOARD_URL=http://localhost:8000

# API cache
API_CACHE_DIR=/tmp/pm-leaderboard-cache

# Job intervals (seconds)
CHECK_ORDERS_INTERVAL=60
AUTO_RESOLVE_INTERVAL=300
